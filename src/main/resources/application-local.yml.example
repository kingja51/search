# 로컬 개발용 오버라이드 예시.
# 기본 접속 정보는 환경 변수(.env.example 참조)로 주입된다.
# 환경 변수 대신 파일로 관리하려면 이 파일을 application-local.yml 로 복사해 수정한다. (git 미추적)
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/search?currentSchema=search,public
    username: postgres
    password: change-me
  thymeleaf:
    cache: false
