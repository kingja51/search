# ============================================================
# .env.example — 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 본인 환경에 맞게 수정한다. (.env는 git 미추적)
#
# ※ Spring Boot는 .env를 자동으로 읽지 않는다. 적용 방법 중 택1:
#   1) IDE 실행 구성(Run Configuration)의 환경 변수에 등록
#   2) PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
#   3) 값을 직접 application-local.yml 에 기재 (git 미추적)
# ============================================================

# ── PostgreSQL 18 ──
# currentSchema=search,public : 앱 테이블은 search 스키마, pg_trgm 함수는 public 참조
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=search,public
DB_USERNAME=postgres
DB_PASSWORD=kingja51
DB_SCHEMA=search

# ── 서버 포트 ──
SERVER_PORT=8080
MANAGEMENT_PORT=9090
